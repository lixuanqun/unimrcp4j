<!--
  Example FreeSWITCH mod_unimrcp profile for java-mrcp.

  Copy the profile into FreeSWITCH's unimrcpserver.xml / mrcp_profiles section
  and adjust server-ip/client-ip/ports for your environment.
-->
<profile name="java-mrcp" version="2">
  <param name="client-ip" value="127.0.0.1"/>
  <param name="client-port" value="0"/>
  <param name="server-ip" value="127.0.0.1"/>
  <param name="server-port" value="8060"/>
  <param name="sip-transport" value="udp"/>
  <param name="ua-name" value="FreeSWITCH"/>
  <param name="sdp-origin" value="FreeSWITCH"/>
  <param name="rtp-ip" value="127.0.0.1"/>
  <param name="rtp-port-min" value="4000"/>
  <param name="rtp-port-max" value="4998"/>
  <param name="codecs" value="PCMU PCMA L16/96/16000"/>
  <param name="speechsynth" value="speechsynth"/>
  <param name="speechrecog" value="speechrecog"/>
</profile>
